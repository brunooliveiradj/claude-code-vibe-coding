# ======================================================
# Vercel Environment Variables — copy to .env.local for dev
# In Vercel: add these in Project Settings > Environment Variables
# ======================================================

# Gemini AI API key (get at https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY="your-gemini-api-key-here"

# Firebase configuration (from your Firebase console > Project settings)
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_DATABASE_ID="your-firestore-database-id"

# ======================================================
# Smart Inbox — backend (server/)
# ======================================================

# Google OAuth (console.cloud.google.com → Credentials → OAuth 2.0 Client ID, tipo Web)
# Redirect URI autorizada: http://localhost:3000/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Preenchido após o primeiro login em /api/auth/google (o token aparece no terminal)
GOOGLE_REFRESH_TOKEN=

# Claude API
ANTHROPIC_API_KEY=

# Porta do backend (o Vite faz proxy de /api para cá)
SERVER_PORT=3001
